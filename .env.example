# Copy this file to .env and fill in the values
# Never commit .env to version control

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api

# PostgreSQL
POSTGRES_DB=compliance_db
POSTGRES_USER=compliance_user
POSTGRES_PASSWORD=compliance_pass
DATABASE_URL=postgres://compliance_user:compliance_pass@db:5432/compliance_db

# Redis (local dev broker) / SQS (production broker)
REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=sqs://   ← set this in production to use AWS SQS

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_RAW_BUCKET=compliance-tracker-raw-fda-data

# Production database (RDS)
# DATABASE_URL=postgres://user:pass@mydb.us-east-1.rds.amazonaws.com:5432/compliance_db
